# cybertech-front — environment variables (validated at startup by lib/env.ts).
# Copy to .env.local and adjust. Local run only (constitution X).

# Spring backend started from IntelliJ.
API_BASE_URL=http://localhost:8081
# Value of the X-API-VERSION header (default: 1.0).
API_VERSION=1.0

# Auth.js — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=change-me-with-npx-auth-secret
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=cybertech-front-client
AUTH_KEYCLOAK_SECRET=dev-keycloak-front-secret-change-me
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/cybertech

# Host serving product images (LocalStack S3).
IMAGES_REMOTE_HOST=localhost:4566

# Public URL of the front (used for page metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables test-only routes for Playwright (default: false).
E2E=false
# debug | info | warn | error (default: info).
LOG_LEVEL=debug
